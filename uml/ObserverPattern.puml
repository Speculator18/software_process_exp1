@startuml
title 观察者模式（炸弹/冰冻道具全局通知）

package "Observer" {
  enum SupplyEvent {
    BOMB
    FREEZE
  }

  interface SupplyObserver {
    + update(event: SupplyEvent): void
  }

  interface SupplySubject {
    + addObserver(observer: SupplyObserver): void
    + removeObserver(observer: SupplyObserver): void
    + notifyObservers(event: SupplyEvent): void
  }

  class SupplyNotifier <<Subject>> {
    - observerList: List<SupplyObserver>
    + addObserver(observer: SupplyObserver): void
    + removeObserver(observer: SupplyObserver): void
    + notifyObservers(event: SupplyEvent): void
  }
}

package "Game Objects" {
  abstract class AbstractProp {
    + activate(heroAircraft: HeroAircraft): void
  }

  class BombProp <<Publisher>> {
    - subject: SupplySubject
    + BombProp(subject: SupplySubject)
    + activate(heroAircraft: HeroAircraft): void
  }

  class FreezeProp <<Publisher>> {
    - subject: SupplySubject
    + FreezeProp(subject: SupplySubject)
    + activate(heroAircraft: HeroAircraft): void
  }

  class EnemyAircraftObserver <<Observer>> {
    - enemyAircrafts: List<AbstractAircraft>
    + EnemyAircraftObserver(enemyAircrafts: List<AbstractAircraft>)
    + update(event: SupplyEvent): void
  }

  class EnemyBulletObserver <<Observer>> {
    - enemyBullets: List<BaseBullet>
    + EnemyBulletObserver(enemyBullets: List<BaseBullet>)
    + update(event: SupplyEvent): void
  }

  class Game
  class HeroAircraft
  abstract class AbstractAircraft
  abstract class BaseBullet
}

SupplySubject <|.. SupplyNotifier
SupplyObserver <|.. EnemyAircraftObserver
SupplyObserver <|.. EnemyBulletObserver

SupplyNotifier o-- SupplyObserver

AbstractProp <|-- BombProp
AbstractProp <|-- FreezeProp

BombProp ..> SupplySubject : notifyObservers(BOMB)
FreezeProp ..> SupplySubject : notifyObservers(FREEZE)

Game ..> SupplyNotifier : register observers
Game ..> AbstractAircraft
Game ..> BaseBullet

@enduml
